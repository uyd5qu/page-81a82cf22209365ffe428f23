r(--ink-soft)}\n.plan ul li:last-child{border-bottom:0}\n.plan ul li::before{content:\"□ \";color:var(--accent)}\n.plan .flag{align-self:flex-start;margin-top:18px;font-size:12px;letter-spacing:.2em;color:var(--ivory);background:var(--wine);padding:4px 10px}\n/* 阶梯递进：逐级抬升 */\n@media (min-width:900px){.plans{align-items:end}\n  .plan:nth-child(2){transform:translateY(-10px)}\n  .plan:nth-child(3){transform:translateY(-20px)}\n  .plan:nth-child(4){transform:translateY(-30px)}}\n\n/* 客户端 */\n.clients{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(230px,1fr))}\n.clients .ticket h3{margin-bottom:6px}\n.clients .ticket p{margin:0;font-size:15px;color:var(--ink-soft)}\n.note{margin-top:26px;border-left:4px solid var(--wine-light);background:var(--ivory-2);padding:16px 18px;font-size:15px;color:var(--ink-soft)}\n\n/* FAQ 分组 */\n.faq-group{margin-bottom:38px}\n.faq-group > h3{font-size:14px;letter-spacing:.26em;color:var(--wine-light);padding-bottom:10px;border-bottom:1px solid var(--line);margin-bottom:18px}\n.faq-list{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}\n.qa{background:#fffdf8;border:1px dashed var(--line);padding:18px 20px}\n.qa h4{margin:0 0 8px;font-size:16px;color:var(--wine)}\n.qa p{margin:0;font-size:15px;color:var(--ink-soft)}\n\n/* 页脚 */\nfooter{background:var(--wine-deep);color:#e6d8c4;padding:44px 0 52px;font-size:14px}\nfooter .wrap{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}\nfooter strong{display:block;color:var(--ivory);font-size:16px;margin-bottom:6px}\nfooter a{color:#f1e4cf}\nfooter ul{margin:0;padding:0;list-style:none}\nfooter li{padding:3px 0}\nfooter li a{text-decoration:none;border-bottom:1px dashed rgba(241,228,207,.45)}\n</style><main>\n\n  <div class=\"band band-wine\">\n    <div class=\"wrap band-inner\">\n      <span class=\"kicker\">FlyShadow · 方案清单</span>\n      <h1>小飞机(FlyShadow) · 小飞机（FlyShadow）\n        <span class=\"en\">Flyshadow · Plans &amp; Notes</span>\n      </h1>\n      <p class=\"hero-lede\">这一页把小飞机（FlyShadow）的三档套餐、开通步骤、客户端准备和常见问题按清单顺序摆在一起。价格、流量、设备数都写在正文里，不藏在折叠层。</p>\n      <ul class=\"hero-meta\">\n        <li>三档套餐：基础版 / 旗舰版 / 团队版</li>\n        <li>按月计费，另有按年付价格</li>\n        <li>设备同时在线数分档设定</li>\n      </ul>\n    </div>\n  </div>\n\n  <div class=\"band band-ivory\">\n    <div class=\"strip\">\n      <div><strong>先看什么</strong><span>先确认每月流量与同时在线设备数，再挑档位。</span></div>\n      <div><strong>怎么开通</strong><span>选档 → 准备设备 → 按页面说明完成配置。</span></div>\n      <div><strong>哪里提问</strong><span>页尾常见问题按主题分组，逐条给答案。</span></div>\n    </div>\n  </div>\n\n  <div class=\"band band-ink\">\n    <div class=\"wrap\">\n      <ul class=\"jump\">\n        <li><a href=\"#howto\">使用说明</a></li>\n        <li><a href=\"#plans\">套餐清单</a></li>\n        <li><a href=\"#clients\">客户端准备</a></li>\n        <li><a href=\"#faq\">常见问题</a></li>\n        <li><a href=\"#notes\">备注与口径</a></li>\n      </ul>\n    </div>\n  </div>\n\n  <section id=\"howto\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"num\">01 / 使用说明</span>\n        <h2>四步走完，别跳步</h2>\n        <p>下面四步是这一页给出的全部操作口径。每一步只做一件事，做完再进下一步，出问题时也方便定位在哪一环。</p>\n      </div>\n      <ol class=\"steps\">\n        <li class=\"ticket\">\n          <h3><em>第一步</em>核对需求</h3>\n          <p>先数清楚你有几台设备要同时在线、每月大概用多少流量。两个数字对上套餐表再往下走，比事后升级省事。</p>\n        </li>\n        <li class=\"ticket\">\n          <h3><em>第二步</em>选定档位</h3>\n          <p>基础版、旗舰版、团队版按流量与设备数分档。旗舰版在页面中带推荐标记，但仍以你自己的设备数为准。</p>\n        </li>\n        <li class=\"ticket\">\n          <h3><em>第三步</em>准备设备</h3>\n          <p>在要用的设备上完成客户端准备。客户端清单见下方区块，仅列名称与用途，不提供下载地址。</p>\n        </li>\n        <li class=\"ticket\">\n          <h3><em>第四步</em>按说明配置</h3>\n          <p>依所选档位对应的配置信息完成设置。配置信息以你开通后获得的内容为准，本页不代填、不转述。</p>\n        </li>\n      </ol>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"num\">02 / 套餐清单</span>\n        <h2>三档套餐，按阶梯递进</h2>\n        <p>三档从左到右逐级抬升：流量增加、同时在线设备数增加、权益逐项叠加。价格单位为人民币，按月计费，另附按年付价格。</p>\n      </div>\n\n      <div class=\"plans\">\n        <div class=\"plan-step\">由低到高 · 基础 → 旗舰 → 团队</div>\n\n        <article class=\"ticket plan\">\n          <span class=\"tier\">TIER 01</span>\n          <h3>基础版</h3>\n          <p class=\"price\">¥15<small>/月</small></p>\n          <p class=\"annual\">按年付仅需 ¥150/年</p>\n          <ul>\n            <li>每月 100GB 流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </article>\n\n        <article class=\"ticket plan\">\n          <span class=\"tier\">TIER 02</span>\n          <h3>旗舰版</h3>\n          <p class=\"price\">¥35<small>/月</small></p>\n          <p class=\"annual\">按年付仅需 ¥350/年</p>\n          <ul>\n            <li>每月 300GB 流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n          <span class=\"flag\">页面推荐档</span>\n        </article>\n\n        <article class=\"ticket plan\">\n          <span class=\"tier\">TIER 03</span>\n          <h3>团队版</h3>\n          <p class=\"price\">¥85<small>/月</small></p>\n          <p class=\"annual\">按年付仅需 ¥850/年</p>\n          <ul>\n            <li>每月 1000GB 流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </article>\n      </div>\n\n      <p class=\"note\">口径说明：以上价格、流量与设备数均按本页套餐清单列示，不额外承诺未列出的性能、节点数量或覆盖地区。年付价格为其对应档位按年支付的金额。</p>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"num\">03 / 客户端准备</span>\n        <h2>先认平台，再谈配置</h2>\n        <p>本页只做清单式说明：你需要什么类型的客户端、它通常用来做什么。具体下载渠道请以你开通后获得的说明为准，本页不提供下载链接。</p>\n      </div>\n      <div class=\"clients\">\n        <article class=\"ticket\">\n          <h3>桌面端</h3>\n          <p>用于电脑上的日常浏览与办公场景。准备一个与你的操作系统匹配的客户端，按配置信息完成设置即可。</p>\n        </article>\n        <article class=\"ticket\">\n          <h3>移动端</h3>\n          <p>用于手机与平板。注意同时在线设备数按账号计算，超出所选档位上限时需减少设备或升级档位。</p>\n        </article>\n        <article class=\"ticket\">\n          <h3>路由与企业侧</h3>\n          <p>团队版包含企业定制路由支持。此类场景涉及内部网络安排，建议先与专属客户经理确认再动手。</p>\n        </article>\n      </div>\n      <p class=\"note\">本页不列出任何下载地址：客户端来源以开通后提供的说明为准。本页也不对第三方客户端的兼容性作出承诺。</p>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"num\">04 / 常见问题</span>\n        <h2>按主题分组，逐条回答</h2>\n        <p>分成三组：套餐选择、开通与设备、计费与变更。每组问题都给出明确答案，不绕圈子。</p>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>主题一 · 套餐选择</h3>\n        <div class=\"faq-list\">\n          <article class=\"qa\">\n            <h4>怎么判断自己该选哪一档？</h4>\n            <p>先看两个硬指标：每月流量和同时在线设备数。设备数 3 台以内、流量需求不高选基础版；设备 5 台左右、希望流媒体解锁覆盖更全选旗舰版；设备多且有内部网络安排需求选团队版。</p>\n          </article>\n          <article class=\"qa\">\n            <h4>旗舰版为什么被标为推荐？</h4>\n            <p>因为它在流量、设备数、流媒体解锁与工单优先级上处于中间档，覆盖多数单人或多设备小规模使用场景。标记只是本页的排序提示，不构成效果承诺，最终以你的实际设备数为准。</p>\n          </article>\n          <article class=\"qa\">\n            <h4>团队版比旗舰版多出的部分是什么？</h4>\n            <p>流量从 300GB 提到 1000GB，同时在线设备数从 5 台提到 20 台，并增加 VIP 专属高带宽节点、企业定制路由支持与专属客户经理服务。</p>\n          </article>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>主题二 · 开通与设备</h3>\n        <div class=\"faq-list\">\n          <article class=\"qa\">\n            <h4>开通之后第一步做什么？</h4>\n            <p>准备设备：在要用的电脑或手机上准备好对应平台的客户端，再按开通后获得的配置信息完成设置。不要先去改设备上的其他网络设置。</p>\n          </article>\n          <article class=\"qa\">\n            <h4>设备数超了会怎样？</h4>\n            <p>同时在线设备数按档位设上限：基础版 3 台、旗舰版 5 台、团队版 20 台。超出上限时，先让不用的设备下线；长期不够用再考虑升级档位。</p>\n          </article>\n          <article class=\"qa\">\n            <h4>本页能提供客户端下载地址吗？</h4>\n            <p>不能。本页只列客户端类型与用途，不提供任何下载链接。来源以你开通后获得的说明为准，避免装到来路不明的版本。</p>\n          </article>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>主题三 · 计费与变更</h3>\n        <div class=\"faq-list\">\n          <article class=\"qa\">\n            <h4>月付和年付差多少？</h4>\n            <p>按本页清单：基础版 ¥15/月、年付 ¥150；旗舰版 ¥35/月、年付 ¥350；团队版 ¥85/月、年付 ¥850。年付价格在其对应档位下按年支付。</p>\n          </article>\n          <article class=\"qa\">\n            <h4>中途想换档怎么处理？</h4>\n            <p>换档涉及已支付周期与权益差异，本页不给出具体折算规则。请按开通时提供的渠道说明办理，或在工单中说明当前档位与目标档位。</p>\n          </article>\n          <article class=\"qa\">\n            <h4>页面没写到的性能或地区信息怎么确认？</h4>\n            <p>本页只对列出的价格、流量、设备数与权益负责，不对未列出的节点数量、地区覆盖或性能指标作说明。需要这些信息时，请通过开通后的官方渠道确认。</p>\n          </article>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"notes\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"num\">05 / 备注与口径</span>\n        <h2>这一页写了什么，没写什么</h2>\n      </div>\n      <div class=\"ticket\">\n        <ul>\n          <li>写了：三档套餐的名称、月付与年付价格、流量、同时在线设备数与权益条目。</li>\n          <li>写了：开通与配置的四步顺序，以及客户端类型与用途。</li>\n          <li>没写：未提供的节点数量、地区覆盖、性能指标与用户评价。</li>\n          <li>没写：任何下载地址与外部交易链接；相关位置一律指向本页锚点。</li>\n        </ul>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div>\n      <strong>小飞机（FlyShadow）</strong>\n      <p>方案与使用说明页。价格、流量、设备数与权益以本页正文列示为准。</p>\n    </div>\n    <div>\n      <strong>页内跳转</strong>\n      <ul>\n        <li><a href=\"#howto\">使用说明</a></li>\n        <li><a href=\"#plans\">套餐清单</a></li>\n        <li><a href=\"#clients\">客户端准备</a></li>\n        <li><a href=\"#faq\">常见问题</a></li>\n      </ul>\n    </div>\n    <div>\n      <strong>口径</strong>\n      <p>本页不提供下载地址，不对未列出的性能、节点与地区信息作说明。</p>\n    </div>\n  </div>\n</footer>",
